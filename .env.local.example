NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Customer activation links (admin creates user → email with one-time link).
# Public URL of this app, used to build the link. Falls back to the request origin.
APP_BASE_URL=https://portal.telliancapital.ch
# Hours until an activation link expires (default 48).
ACTIVATION_LINK_TTL_HOURS=48

# Brevo transactional email (https://app.brevo.com → SMTP & API → API keys).
# Without BREVO_API_KEY nothing is sent; the admin gets the link to pass on manually.
BREVO_API_KEY=
EMAIL_FROM=telliancapital@wondercode.ch
EMAIL_FROM_NAME=Tellian Capital
